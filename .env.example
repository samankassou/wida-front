# Leave unset to explore the local demo workspace.
# Server-only ASP.NET API origin, without the /api suffix.
# Use a trusted HTTPS certificate or the local HTTP launch profile.
WIDA_API_URL=http://localhost:5085
# Public frontend origin; must match the API's Authentication:PublicOrigin.
# Required in live production. Use HTTPS on shared deployments.
WIDA_PUBLIC_ORIGIN=http://localhost:3000

# Required in live production: a single-IP header OVERWRITTEN by your trusted ingress.
# Next.js must only be reachable through that ingress. Never trust arbitrary X-Forwarded-For.
# Example for Nginx directly facing clients: proxy_set_header X-Real-IP $remote_addr;
# WIDA_CLIENT_IP_HEADER=x-real-ip
# API must trust the Next.js connection IP via RateLimiting__TrustedProxies__0.
